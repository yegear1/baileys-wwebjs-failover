# ==============================================================================
# baileys-wwebjs-failover Configuration
# ==============================================================================

NODE_ENV=development
PORT=3000

# Redis Connection
REDIS_URL=redis://127.0.0.1:6379

# Authentication Storage Paths
AUTH_DIR_BAILEYS=/data/auth/baileys
AUTH_DIR_WWEBJS=/data/auth/wwebjs

# Failover & Circuit Breaker
FAILOVER_ERROR_THRESHOLD=3
PROBE_STABILITY_WINDOW_SEC=300

# Standby Keep-Alive Jitter (Days)
KEEPALIVE_INTERVAL_DAYS_MIN=3
KEEPALIVE_INTERVAL_DAYS_MAX=5
