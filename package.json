{
  "name": "baileys-wwebjs-failover",
  "version": "0.1.0",
  "description": "Hybrid active-passive WhatsApp gateway pairing Baileys (primary socket) with WhatsApp-Web.js (standby Puppeteer) with zero-loss failover",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "pino": "^9.6.0",
    "redis": "^4.7.1",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.13.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "libsignal": "2.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
