# ==============================================================================
# baileys-wwebjs-failover Configuration
# ==============================================================================

NODE_ENV=production
SERVICE_NAME=baileys-wwebjs-failover
LOG_LEVEL=info
NO_COLOR=1
PORT=3000

# Redis Connection (use redis service hostname inside Docker Compose network)
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Authentication Storage Paths (Segregated local volumes)
AUTH_DIR_BAILEYS=/data/auth/baileys
AUTH_DIR_WWEBJS=/data/auth/wwebjs

# Chromium Binary Path (used by WWebJS Standby Engine)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Failover, Circuit Breaker & Connectivity Guard
FAILOVER_ERROR_THRESHOLD=3
PROBE_STABILITY_WINDOW_SEC=300
ENABLE_HOST_CONNECTIVITY_GUARD=true

# Outbound Dispatch, Retries & Dead Letter Queue (DLQ)
SEND_MESSAGE_TIMEOUT_MS=15000
MAX_SEND_RETRIES=3
DLQ_QUEUE_KEY=whatsapp:send:dlq
ENABLE_TYPING_PRESENCE=true
URGENT_DELAY_MIN_MS=300
URGENT_DELAY_MAX_MS=800
NORMAL_DELAY_MIN_MS=1500
NORMAL_DELAY_MAX_MS=3500
LOW_DELAY_MIN_MS=10000
LOW_DELAY_MAX_MS=20000

# Standby Keep-Alive Jitter (Days)
KEEPALIVE_INTERVAL_DAYS_MIN=3
KEEPALIVE_INTERVAL_DAYS_MAX=5

# Redis Queues & Fencing Keys (Optional overrides)
# INBOX_QUEUE_KEY=whatsapp:receive:inbox
# OUTBOUND_QUEUE_KEY=whatsapp:send:priority
# LOW_PRIORITY_OUTBOUND_QUEUE_KEY=whatsapp:send:low
# FENCING_LOCK_KEY=gateway:active_engine
# BLPOP_TIMEOUT_SECONDS=2
# SHUTDOWN_TIMEOUT_MS=10000
